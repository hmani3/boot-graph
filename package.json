{
  "name": "bootgraph",
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive visual setup & dependency graph for any codebase",
  "bin": {
    "bootgraph": "./dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/cli/index.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "onboarding",
    "developer-experience",
    "setup",
    "dag",
    "react-flow",
    "graph",
    "dependencies",
    "docker",
    "terminal"
  ],
  "author": "BootGraph Contributors",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
